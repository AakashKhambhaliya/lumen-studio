# Copy to .env.local. All variables are optional.

# Higgsfield API key used for every visitor: in https://console.higgsfield.ai,
# create a key and paste the value from "Copy API Key". HF_CREDENTIALS is
# accepted as an alias. The older separate HF_API_KEY_ID / HF_API_KEY_SECRET
# variables also still work. Without a key here, each browser connects its own
# key from the Settings dialog.
HF_KEY=

# Encrypts API keys saved from the Settings dialog. Use a long random value,
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`.
LUMEN_SESSION_SECRET=

# Point at the local mock (`npm run mock:higgsfield`) during development.
# HIGGSFIELD_API_BASE=http://localhost:4010
