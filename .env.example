# Copy to .env.local. All variables are optional.

# Higgsfield credentials used for every visitor (https://console.higgsfield.ai).
# Without them, each browser connects its own key from the Settings dialog.
HF_API_KEY_ID=
HF_API_KEY_SECRET=

# Encrypts credentials saved from the Settings dialog. Use a long random value,
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`.
LUMEN_SESSION_SECRET=

# Point at the local mock (`npm run mock:higgsfield`) during development.
# HIGGSFIELD_API_BASE=http://localhost:4010
